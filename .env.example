# Copy to .env.local and fill in.

# ---- Public (safe to expose to the browser) ---------------------------------------------------
# Local Supabase (`npx supabase start` prints these):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Map tiles (see README "Map & India's borders"). Defaults are fine for development only.
# Default is Esri "World Light Gray Base" (keyless, DEVELOPMENT ONLY). CARTO's free tiles now return an "API KEY REQUIRED" watermark.
# For production use a licensed provider (MapTiler, Stadia, Esri with a key, or self-hosted) and set:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/<style>/{z}/{x}/{y}.png?key=...
# NEXT_PUBLIC_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors

# ---- SERVER-ONLY SECRETS: never prefix with NEXT_PUBLIC_, never commit ---------------------------
# Needed by the payment routes only (create_payment_order / fulfill_payment are service-role functions).
# Locally: the SERVICE_ROLE_KEY printed by `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# Payments. For local development use mock mode: no Razorpay account, no real money, and the real
# webhook code path still runs. Mock mode is impossible in production builds.
RAZORPAY_MODE=mock
# Live / Razorpay TEST mode (leave RAZORPAY_MODE unset):
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...     # must differ from the key secret; set the same value in the Razorpay dashboard

# Background workers: /api/cron/{ping,github-score}. Anything without `Authorization: Bearer $CRON_SECRET` gets 401.
# Locally run them with `npm run workers`; on Vercel set the same variable and add cron entries (see README).
CRON_SECRET=change_me_to_a_long_random_string_16plus
# GitHub scorer: a token with NO scopes (public data only) lifts the API limit from 60 to 5,000 requests/hour. Optional locally.
# GITHUB_TOKEN=ghp_...

# ---- Sprint 4: client attestation + support -------------------------------------------------------------------
# Public address used in links we E-MAIL to clients. Set it explicitly (never derived from the request's Host header).
# Locally: http://localhost:3000. In production: https://devmap.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keyed hash for client contacts (so abuse limits work without storing addresses). 32+ random chars: openssl rand -hex 24
# CHANGING IT later resets the "2 confirmations per client per 30 days" memory, so set it once.
ATTESTATION_HMAC_SECRET=change_me_to_at_least_32_random_characters_xxxxxxxx
# How mail leaves the app: any provider's SMTP URL. Local Mailpit (see http://127.0.0.1:54324):
SMTP_URL=smtp://127.0.0.1:54325
MAIL_FROM="DevMap <no-reply@devmap.in>"
# Free, no-DNS option for the beta: send through your Gmail with an App Password (see DEPLOY.md). Gmail only lets you send
# AS that address, so MAIL_FROM must be the Gmail too:
# SMTP_URL=smtps://diadem.xeiver%40gmail.com:YOUR_16_CHAR_APP_PASSWORD@smtp.gmail.com:465
# MAIL_FROM="DevMap <diadem.xeiver@gmail.com>"
# MAIL_MODE=mock    # prints instead of sending (impossible in production)
# Shown in strike notices as the appeal address.
SUPPORT_EMAIL=diadem.xeiver@gmail.com

# --- Company facts printed on the legal pages and footer. Leave a line out and it is simply omitted (nothing is invented). ---
# NEXT_PUBLIC_COMPANY_LEGAL_NAME="DevMap Technologies Private Limited"
# NEXT_PUBLIC_COMPANY_ADDRESS=
# NEXT_PUBLIC_COMPANY_GSTIN=
# NEXT_PUBLIC_GRIEVANCE_NAME=
# City whose courts the Terms name. Until set, the Terms say "the place of our registered office in India".
# NEXT_PUBLIC_JURISDICTION="Mumbai, Maharashtra"
