# Copy to supabase/.env (git-ignored). The Supabase CLI substitutes these into config.toml env(...) values.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=dummy-local-token
# GitHub OAuth app (callback http://127.0.0.1:54321/auth/v1/callback)
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# Google OAuth client (same callback URL)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
